---
import { cn } from "@/lib/utils";

interface Props {
  url?: string;
  class?: string;
  [key: string]: unknown;
}

const { url, class: className, ...rest } = Astro.props;
const cardClass = cn(
  "inline-block border-2 rounded shadow-md transition-all hover:shadow-none bg-card",
  className,
);
const Element = url ? "a" : "div";
const elementProps = url ? { href: url, ...rest } : rest;
---

<Element class={cardClass} {...elementProps}>
  <slot name="media" />
  <slot name="header" />
  <slot />
</Element>
