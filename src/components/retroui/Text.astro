---
import { cn } from "@/lib/utils";
import { textVariants, type TextVariantProps } from "./text-variants";

interface Props extends TextVariantProps {
  class?: string;
  [key: string]: unknown;
}

const {
  as = "p",
  alignment,
  text_color,
  class: className,
  ...otherProps
} = Astro.props;

const resolvedAs = as ?? "p";
const Tag = resolvedAs;
---

<Tag
  class={cn(textVariants({ as: resolvedAs, alignment, text_color }), className)}
  {...otherProps}
>
  <slot />
</Tag>
