---
import StoryblokComponent from '@storyblok/astro/StoryblokComponent.astro';
import { storyblokEditable } from '@storyblok/astro';
import { cva } from 'class-variance-authority';
import { cn } from '@/lib/utils';

const { blok } = Astro.props;

const sectionVariants = cva('', {
	variants: {
		background: {
			transparent: 'bg-transparent',
			background: 'bg-background',
			primary: 'bg-primary',
			secondary: 'bg-secondary',
			card: 'bg-card',
			muted: 'bg-muted',
			accent: 'bg-accent',
			destructive: 'bg-destructive',
		},
	},
});

type BgKey = 'transparent' | 'background' | 'primary' | 'secondary' | 'card' | 'muted' | 'accent' | 'destructive';
const BG_VALUES: BgKey[] = ['transparent', 'background', 'primary', 'secondary', 'card', 'muted', 'accent', 'destructive'];

function parseBg(value: unknown): BgKey | undefined {
	return BG_VALUES.includes(value as BgKey) ? (value as BgKey) : undefined;
}

const background = parseBg(blok.background);
const customBackground = !background &&	typeof blok.custom_background.color === 'string' && blok.custom_background.color.trim()
		? blok.custom_background.color.trim()
		: undefined;

const ariaAttrs = blok.aria_label ? { 'aria-label': blok.aria_label } : {};
const inlineStyle = customBackground ? { backgroundColor: customBackground } : {};

const sectionClass = cn('py-4 px-4', sectionVariants({ background }), blok.hero_section ? 'min-h-[80vh] py-16': '');
---

<section
	class:list={[sectionClass]}
	style={inlineStyle}
	id={blok.id}
	{...ariaAttrs}
	{...storyblokEditable(blok)}
>
	{
		blok.content?.map((nestedBlok) => {
			return <StoryblokComponent blok={nestedBlok} />;
		})
	}
</section>
