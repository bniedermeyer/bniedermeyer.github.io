---
import RetroCard from '@/components/retroui/Card.astro';
import StoryblokComponent from '@storyblok/astro/StoryblokComponent.astro';
import StoryblokImage from '@/components/StoryblokImage.astro';
import Text from '@/components/retroui/Text.astro';
import { storyblokEditable } from '@storyblok/astro';
const { blok } = Astro.props;
const hasHeader = blok.title || blok.description;
const asset = blok.image;
const hasImage = asset?.filename;
let url = undefined;
if (blok.link) {
	url = blok.link.linktype === 'story' && blok.link.cached_url ? `/${blok.link.cached_url}` : blok.link.url;
}
---

<RetroCard url={url}{...storyblokEditable(blok)}>
	{hasImage && (
		<div slot="media" class="mt-4 p-4 flex items-center justify-center aspect-square overflow-hidden">
			<StoryblokImage
				src={asset.filename}
				alt={asset.alt ?? ''}
				class="w-full h-full object-contain"
			/>
		</div>
	)}
	{hasHeader && (
		<div slot="header" class:list={["flex flex-col justify-start p-4", { "pb-0": hasImage }]}>
			{blok.title && <Text as="h3" class="mb-2">{blok.title}</Text>}
			{blok.description && <p class="text-muted-foreground">{blok.description}</p>}
		</div>
	)}
	<div class="p-4">
		{
			blok.content?.map((nestedBlok) => (
				<StoryblokComponent blok={nestedBlok} />
			))
		}
	</div>
</RetroCard>
