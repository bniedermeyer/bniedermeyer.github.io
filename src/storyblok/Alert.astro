---
import { Alert as RetroAlert } from '@/components/retroui/Alert';
import { storyblokEditable } from '@storyblok/astro';
const { blok } = Astro.props;
---

<RetroAlert {...storyblokEditable(blok)} variant={blok.variant} status={blok.status}>
	{blok.title && (
		<RetroAlert.Title>{blok.title}</RetroAlert.Title>
	)}
	{blok.description && (
		<RetroAlert.Description>{blok.description}</RetroAlert.Description>
	)}
</RetroAlert>
