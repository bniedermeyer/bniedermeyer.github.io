---
import RetroAlert from '@/components/retroui/Alert.astro';
import { storyblokEditable } from '@storyblok/astro';
const { blok } = Astro.props;
---

<RetroAlert {...storyblokEditable(blok)} variant={blok.variant} status={blok.status}>
	{blok.title && (
		<Fragment slot="title">{blok.title}</Fragment>
	)}
	{blok.description && (
		<Fragment slot="description">{blok.description}</Fragment>
	)}
</RetroAlert>
