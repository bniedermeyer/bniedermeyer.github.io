---
import StoryblokComponent from '@storyblok/astro/StoryblokComponent.astro';
import { storyblokEditable } from '@storyblok/astro';
import { cva } from 'class-variance-authority';
import { cn } from '@/lib/utils';

const COL_VALUES = [1, 2, 3, 4, 5, 6] as const;
const GAP_VALUES = [0, 2, 4, 6, 8, 10, 12] as const;
type ColKey = (typeof COL_VALUES)[number];
type GapKey = (typeof GAP_VALUES)[number];

const gridVariants = cva('grid', {
	variants: {
		cols: { 1: 'grid-cols-1', 2: 'grid-cols-2', 3: 'grid-cols-3', 4: 'grid-cols-4', 5: 'grid-cols-5', 6: 'grid-cols-6' },
		colsMd: { 1: 'md:grid-cols-1', 2: 'md:grid-cols-2', 3: 'md:grid-cols-3', 4: 'md:grid-cols-4', 5: 'md:grid-cols-5', 6: 'md:grid-cols-6' },
		colsLg: { 1: 'lg:grid-cols-1', 2: 'lg:grid-cols-2', 3: 'lg:grid-cols-3', 4: 'lg:grid-cols-4', 5: 'lg:grid-cols-5', 6: 'lg:grid-cols-6' },
		colsXl: { 1: 'xl:grid-cols-1', 2: 'xl:grid-cols-2', 3: 'xl:grid-cols-3', 4: 'xl:grid-cols-4', 5: 'xl:grid-cols-5', 6: 'xl:grid-cols-6' },
		gap: { 0: 'gap-0', 2: 'gap-2', 4: 'gap-4', 6: 'gap-6', 8: 'gap-8', 10: 'gap-10', 12: 'gap-12' },
		gapMd: { 0: 'md:gap-0', 2: 'md:gap-2', 4: 'md:gap-4', 6: 'md:gap-6', 8: 'md:gap-8', 10: 'md:gap-10', 12: 'md:gap-12' },
		gapLg: { 0: 'lg:gap-0', 2: 'lg:gap-2', 4: 'lg:gap-4', 6: 'lg:gap-6', 8: 'lg:gap-8', 10: 'lg:gap-10', 12: 'lg:gap-12' },
		gapXl: { 0: 'xl:gap-0', 2: 'xl:gap-2', 4: 'xl:gap-4', 6: 'xl:gap-6', 8: 'xl:gap-8', 10: 'xl:gap-10', 12: 'xl:gap-12' },
	},
	defaultVariants: {
		cols: 1,
		gap: 4,
	},
});

function parseCol(value: unknown): ColKey {
	const num = Number(value);
	return num >= 1 && num <= 6 ? (num as ColKey) : null;
}

function parseGap(value: unknown): GapKey {
	const num = Number(value);
	return (GAP_VALUES as readonly number[]).includes(num) ? (num as GapKey) : null;
}

const { blok } = Astro.props;

/* Cascade: each breakpoint inherits from the previous if unset */
const cols = parseCol(blok.col_count);

const colsMd = parseCol(blok.col_count_md ?? cols);
const colsLg = parseCol(blok.col_count_lg ?? colsMd);
const colsXl = parseCol(blok.col_count_xl ?? colsLg);

const gap = parseGap(blok.gap);

const gapMd = parseGap(blok.gap_md ?? gap);
const gapLg = parseGap(blok.gap_lg ?? gapMd);
const gapXl = parseGap(blok.gap_xl ?? gapLg);

const gridClass = cn(
	gridVariants({
		cols,
		colsMd,
		colsLg,
		colsXl,
		gap,
		gapMd,
		gapLg,
		gapXl,
	}),
);

---

<div class={gridClass} {...storyblokEditable(blok)}>
	{
		blok.content?.map((nestedBlok) => {
			return <StoryblokComponent blok={nestedBlok} />;
		})
	}
</div>
